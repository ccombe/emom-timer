{
  "name": "emom-timer",
  "version": "1.0.0",
  "type": "module",
  "description": "[**🏆 Live Demo &rarr;**](https://ccombe.github.io/emom-timer/)",
  "keywords": [],
  "homepage": "https://github.com/ccombe/emom-timer#readme",
  "bugs": {
    "url": "https://github.com/ccombe/emom-timer/issues"
  },
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccombe/emom-timer.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "coverage": "vitest run --coverage",
    "lint": "oxlint -c .oxlintrc.json",
    "format": "oxfmt",
    "fallow": "fallow dead-code --fail-on-issues",
    "deps": "fallow dead-code --unused-deps --unlisted-deps --fail-on-issues",
    "analyze": "fallow --fail-on-issues",
    "dead-code": "fallow dead-code --fail-on-issues",
    "mcp:fallow": "fallow-mcp"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "fake-indexeddb": "^6.2.5",
    "fallow": "^3.17.0",
    "idb": "^8.0.3",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
